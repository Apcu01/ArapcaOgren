# MySQL bağlantısı (mysql://kullanici:sifre@sunucu:port/veritabani)
DATABASE_URL="mysql://user:password@localhost:3306/arblearn"
# Sitenin yayındaki adresi (site haritası, paylaşım görselleri ve Google girişi bunu kullanır)
SITE_URL="http://localhost:3000"

# Google ile giriş (isteğe bağlı). İkisi de boşsa "Google ile devam et" düğmesi görünmez.
# Google Cloud Console > API'ler ve Hizmetler > Kimlik bilgileri > OAuth istemci kimliği (Web uygulaması)
# Yetkili yönlendirme URI'si: <SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Toplu ses üretimi için (npm run audio:generate). Yalnızca bu komut kullanır, siteye gönderilmez.
OPENROUTER_API_KEY=""

# Kelime bul: yapay zekâ modeli (OpenRouter) ve günlük yeni arama tavanı (önbellekten gelenler sayılmaz)
LOOKUP_MODEL=deepseek/deepseek-v4-flash-0731
LOOKUP_DAILY_LIMIT=2000
